# Copia este archivo como backend/.env para desarrollo local (config.py lo carga con python-dotenv)
SECRET_KEY=cambia-esta-clave
# Por defecto sqlite en backend/store.db. Acepta cualquier URL de SQLAlchemy
# DATABASE_URL=sqlite:///store.db
# URL pública desde la que se abre el frontend (Webpay vuelve a esta URL)
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS separados por coma (por defecto FRONTEND_URL)
# CORS_ORIGINS=http://localhost:5173
# true en producción (HTTPS)
COOKIE_SECURE=false
# integration = credenciales públicas de prueba de Transbank | production = TBK_COMMERCE_CODE/TBK_API_KEY
TBK_ENV=integration
TBK_COMMERCE_CODE=
TBK_API_KEY=
